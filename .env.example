# --- Supabase (auth, base de données, crédits) ---
# Sans ces trois variables, l'app démarre automatiquement en MODE DÉMO
# (stockage en mémoire, 3 crédits offerts, paiements simulés, génération locale).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Génération IA (Anthropic) ---
# Sans clé, le générateur local intégré prend le relais (aucun appel réseau).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8000

# --- Application ---
# 'production' désactive TOUT repli démo, même si une clé manque (fail-fast).
# 'demo' force le mode démo. Absent = auto (démo si Supabase non configuré).
NIMBA_MODE=
# En production, utiliser l'URL publique réelle : https://nimba.optima-works.gn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Paiement (à brancher dans src/lib/payments.ts) ---
# Secret utilisé par votre adaptateur pour vérifier la signature du webhook.
PAYMENT_WEBHOOK_SECRET=

# --- Compte de test (MODE DÉMO uniquement) ---
# Valeurs réelles dans .env.development.local (ignoré par Git).
# Ignorées quand NIMBA_MODE=production. À supprimer avant mise en ligne.
NIMBA_TEST_ADMIN_EMAIL=
NIMBA_TEST_ADMIN_PASSWORD=

# --- Aperçu intégré (iframe cross-site) ---
# Force SameSite=None; Secure; Partitioned si la détection automatique échoue.
# Laisser vide en production top-level.
NIMBA_COOKIE_PARTITIONED=
